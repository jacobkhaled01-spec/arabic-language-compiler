برنامج العد_التنازلي ؛

/* مثال 5: حلقة طالما الشرطية (طالما ... استمر) */
متغير
    الرقم : صحيح ؛

{
    الرقم = 10 ؛

    اطبع ( "--- بدء العد التنازلي ---" ) ؛

    طالما ( الرقم > 0 ) استمر {
        اطبع ( "الرقم الحالي: " , الرقم ) ؛
        الرقم = الرقم - 2 ؛
    } ؛

    اطبع ( "انتهى العد التنازلي بنجاح" ) ؛
} .
