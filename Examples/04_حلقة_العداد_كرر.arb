برنامج حساب_مجموع_الاعداد ؛

/* مثال 4: حلقة العداد المحددة (كرر ... الى ... اضف) */
متغير
    العداد , المجموع_التراكمي : صحيح ؛

{
    المجموع_التراكمي = 0 ؛

    اطبع ( "بدء حلقة التكرار لحساب مجموع الاعداد من 1 الى 5:" ) ؛

    كرر ( العداد = 1 الى 5 اضف 1 ) {
        المجموع_التراكمي = المجموع_التراكمي + العداد ؛
        اطبع ( "قيمة العداد = " , العداد ) ؛
    } ؛

    اطبع ( "المجموع النهائي للاعداد = " , المجموع_التراكمي ) ؛
} .
