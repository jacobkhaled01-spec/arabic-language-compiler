برنامج فحص_العمليات_المنطقية ؛

/* مثال 2: العمليات المنطقية ومعاملات الربط والمقارنة */
متغير
    س , ص : صحيح ؛
    حالة_التحقق : منطقي ؛

{
    س = 50 ؛
    ص = 30 ؛
    حالة_التحقق = صح ؛

    /* فحص معاملات المقارنة والربط المنطقي */
    اذا ( ( س > ص ) && ( ص != 0 ) && حالة_التحقق ) فان {
        اطبع ( "الشرط المنطقي المركب صحيح بالكامل" ) ؛
    } والا {
        اطبع ( "الشرط المنطقي غير محقق" ) ؛
    } ؛

    اطبع ( "نهاية فحص المنطق" ) ؛
} .
