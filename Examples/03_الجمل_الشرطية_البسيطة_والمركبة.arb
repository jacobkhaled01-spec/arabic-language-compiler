برنامج تصنيف_الدرجات ؛

/* مثال 3: الجمل الشرطية المتعددة (اذا ... فان ... والا اذا ... والا) */
متغير
    الدرجة : صحيح ؛

{
    الدرجة = 85 ؛

    اذا ( الدرجة >= 90 ) فان {
        اطبع ( "التقدير: ممتاز" ) ؛
    } ؛
    والا اذا ( الدرجة >= 80 ) فان {
        اطبع ( "التقدير: جيد جدا" ) ؛
    } ؛
    والا اذا ( الدرجة >= 65 ) فان {
        اطبع ( "التقدير: جيد" ) ؛
    } ؛
    والا اذا ( الدرجة >= 50 ) فان {
        اطبع ( "التقدير: مقبول" ) ؛
    } ؛
    والا {
        اطبع ( "التقدير: راسب" ) ؛
    } ؛

    اطبع ( "تم الانتهاء من حساب التقدير" ) ؛
} .
