برنامج مضاعفة_الارقام ؛

/* مثال 6: حلقة أعد حتى (اعد ... حتى) */
متغير
    القيمة : صحيح ؛

{
    القيمة = 1 ؛

    اطبع ( "--- بدء مضاعفة القيمة حتى تتجاوز 15 ---" ) ؛

    اعد {
        القيمة = القيمة * 2 ؛
        اطبع ( "القيمة بعد المضاعفة = " , القيمة ) ؛
    } حتى ( القيمة >= 16 ) ؛

    اطبع ( "وصلت القيمة الى الهدف النهائي" ) ؛
} .
