برنامج معالجة_المصفوفات_الأحادية ؛

/*
    برنامج إدخال عناصر مصفوفة أحادية بعدد عناصر n
    يحتوي على:
    1. إجراء لقراءة عناصر المصفوفة
    2. إجراء لطباعة عناصر المصفوفة
    3. إجراء لترتيب عناصر المصفوفة تصاعدياً
    4. إجراء لنقل عناصر المصفوفة إلى مصفوفة ثانية
    مع طباعة العناصر قبل الترتيب وبعد الترتيب
*/

نوع
    نوع_مصفوفة = قائمة [ 10 ] من صحيح ؛

متغير
    مصفوفة_أ ، مصفوفة_ب : نوع_مصفوفة ؛
    ن : صحيح ؛

    /* 1. إجراء قراءة عناصر المصفوفة (باستقبال المصفوفة بالمرجع وعدد العناصر) */
    اجراء قراءة_المصفوفة ( بالمرجع مصفوفة_القراءة : نوع_مصفوفة ؛ ن_العناصر : صحيح ) ؛
    متغير
        د ، مؤقت : صحيح ؛
    {
        اطبع ( "--- مرحلة إدخال عناصر المصفوفة ---" ) ؛
        كرر ( د = 1 الى ن_العناصر اضف 1 ) {
            اطبع ( "ادخل العنصر رقم: " , د ) ؛
            اقرا ( مؤقت ) ؛
            مصفوفة_القراءة [ د ] = مؤقت ؛
        } ؛
    } ؛

    /* 2. إجراء طباعة عناصر المصفوفة (باستقبال المصفوفة وعدد العناصر كمعاملات) */
    اجراء طباعة_المصفوفة ( مصفوفة_الطباعة : نوع_مصفوفة ؛ ن_العناصر : صحيح ) ؛
    متغير
        د : صحيح ؛
    {
        كرر ( د = 1 الى ن_العناصر اضف 1 ) {
            اطبع ( "العنصر [" , د , "] = " , مصفوفة_الطباعة [ د ] ) ؛
        } ؛
    } ؛

    /* 3. إجراء ترتيب عناصر المصفوفة تصاعدياً (باستقبال المصفوفة بالمرجع وعدد العناصر) */
    اجراء ترتيب_تصاعدي ( بالمرجع مصفوفة_الترتيب : نوع_مصفوفة ؛ ن_العناصر : صحيح ) ؛
    متغير
        د ، ج ، مؤقت : صحيح ؛
    {
        كرر ( د = 1 الى ن_العناصر اضف 1 ) {
            كرر ( ج = 1 الى ن_العناصر - 1 اضف 1 ) {
                اذا ( مصفوفة_الترتيب [ ج ] > مصفوفة_الترتيب [ ج + 1 ] ) فان {
                    مؤقت = مصفوفة_الترتيب [ ج ] ؛
                    مصفوفة_الترتيب [ ج ] = مصفوفة_الترتيب [ ج + 1 ] ؛
                    مصفوفة_الترتيب [ ج + 1 ] = مؤقت ؛
                } ؛
            } ؛
        } ؛
    } ؛

    /* 4. إجراء نقل عناصر مصفوفة لمصفوفة ثانية (باستقبال مصفوفتين والتمرير بالمرجع) */
    اجراء نقل_المصفوفة ( مصفوفة_المصدر : نوع_مصفوفة ؛ بالمرجع مصفوفة_الهدف : نوع_مصفوفة ؛ ن_العناصر : صحيح ) ؛
    متغير
        د : صحيح ؛
    {
        كرر ( د = 1 الى ن_العناصر اضف 1 ) {
            مصفوفة_الهدف [ د ] = مصفوفة_المصدر [ د ] ؛
            اطبع ( "تم نقل مصفوفة_الهدف [" , د , "] = " , مصفوفة_الهدف [ د ] ) ؛
        } ؛
    } ؛

{
    /* تحديد عدد عناصر المصفوفة n مع التحقق وإعادة طلب الإدخال */
    اطبع ( "ادخل عدد عناصر المصفوفة (n):" ) ؛
    اقرا ( ن ) ؛

    /* التحقق من صحة عدد العناصر وإعادة طلب الإدخال طالما أن القيمة غير مقبولة */
    طالما ( ن <= 0 || ن > 10 ) استمر {
        اطبع ( "خطأ: يجب أن يكون عدد العناصر بين 1 و 10! يرجى إعادة إدخال (n):" ) ؛
        اقرا ( ن ) ؛
    } ؛

    /* 1. قراءة العناصر بتمرير مصفوفة_أ بالمرجع وعدد العناصر ن كمعاملات */
    قراءة_المصفوفة ( مصفوفة_أ ، ن ) ؛

    /* 2. طباعة العناصر قبل الترتيب بتمرير مصفوفة_أ وعدد العناصر ن */
    اطبع ( "=== عناصر المصفوفة (قبل الترتيب) ===" ) ؛
    طباعة_المصفوفة ( مصفوفة_أ ، ن ) ؛

    /* 3. الترتيب التصاعدي بتمرير مصفوفة_أ بالمرجع وعدد العناصر ن */
    اطبع ( "--- جاري الترتيب التصاعدي... ---" ) ؛
    ترتيب_تصاعدي ( مصفوفة_أ ، ن ) ؛

    /* 4. طباعة العناصر بعد الترتيب بتمرير مصفوفة_أ وعدد العناصر ن */
    اطبع ( "=== عناصر المصفوفة (بعد الترتيب التصاعدي) ===" ) ؛
    طباعة_المصفوفة ( مصفوفة_أ ، ن ) ؛

    /* 5. نقل العناصر إلى مصفوفة ثانية باستدعاء الإجراء بالمعاملات والتمرير بالمرجع */
    اطبع ( "=== نقل عناصر المصفوفة إلى مصفوفة ثانية (بالتمرير بالمرجع) ===" ) ؛
    نقل_المصفوفة ( مصفوفة_أ ، مصفوفة_ب ، ن ) ؛

    /* 6. طباعة عناصر المصفوفة الثانية المنقول إليها للتأكيد التام على نجاح النقل */
    اطبع ( "=== عناصر المصفوفة الثانية (بعد النقل بالمرجع) ===" ) ؛
    طباعة_المصفوفة ( مصفوفة_ب ، ن ) ؛

    اطبع ( "تم تنفيذ كافة الإجراءات بنجاح!" ) ؛
} .
